{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "requireBranch": ["main", "rc"],
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "hooks": {
    "before:init": "bun run check:version",
    "after:bump": "bun scripts/version.ts sync ${version}",
    "before:git:release": "bun run check:version"
  }
}
