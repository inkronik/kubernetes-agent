# ── Required ──────────────────────────────────────────────────────────────────
# Optional HTTPS override; defaults to the hosted Inkronik Collector below.
INKRONIK_COLLECTOR_URL=https://collector.inkronik.codemask.dev
# Kubernetes cluster-agent ingest key created without selecting an application.
INKRONIK_INGEST_API_KEY=
# Logical name of the cluster this agent monitors.
INKRONIK_CLUSTER_NAME=local-cluster

# ── Scope ─────────────────────────────────────────────────────────────────────
# Optional legacy batch-owner application uuid. Leave empty for cluster-agent keys.
INKRONIK_APPLICATION_ID=
INKRONIK_ENVIRONMENT=prod
INKRONIK_CLUSTER_PROVIDER=kubernetes
# Defaults to the version embedded in the binary. Usually no override is needed.
INKRONIK_K8S_AGENT_VERSION=

# ── Kubernetes access ─────────────────────────────────────────────────────────
# Path to a kubeconfig file. Leave empty to use the in-cluster service account.
INKRONIK_KUBECONFIG=
# Comma-separated namespaces to watch. Empty = all namespaces.
INKRONIK_NAMESPACES=
# Comma-separated event types to forward (default: Warning).
INKRONIK_EVENT_TYPES=Warning
# Set false to disable kubelet filesystem/network stats and nodes/proxy access.
INKRONIK_KUBELET_STATS_ENABLED=true

# ── Health + intervals ────────────────────────────────────────────────────────
INKRONIK_HEALTH_ADDR=:8080
INKRONIK_METRICS_INTERVAL_SECONDS=30
INKRONIK_EVENT_SYNC_INTERVAL_SECONDS=30
INKRONIK_INITIAL_EVENT_LOOKBACK_SECONDS=300
INKRONIK_REQUEST_TIMEOUT_SECONDS=10
